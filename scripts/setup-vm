#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_SSH_HOST="localhost"
REMOTE_SETUP_DIR_BASE="setup"
SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)

INSTALL_CORE_PACKAGES_SCRIPT="01-install-core-packages.sh"
SETUP_ZSH_SCRIPT="02-setup-zsh.sh"
INSTALL_RUNTIMES_SCRIPT="03-install-runtimes.sh"
SETUP_SCRIPTS=("$INSTALL_CORE_PACKAGES_SCRIPT" "$SETUP_ZSH_SCRIPT" "$INSTALL_RUNTIMES_SCRIPT")

usage() {
    printf 'Usage: %s -p <port> -c <user>:<pass> [-i <ip>]\n' "$(basename "$0")" >&2
    exit 1
}

PORT=""
CREDENTIALS=""
SSH_HOST="$DEFAULT_SSH_HOST"

while getopts ":p:c:i:" opt; do
    case "$opt" in
        p) PORT="$OPTARG" ;;
        c) CREDENTIALS="$OPTARG" ;;
        i) SSH_HOST="$OPTARG" ;;
        *) usage ;;
    esac
done

if [[ -z "$PORT" || -z "$CREDENTIALS" ]]; then
    usage
fi

if [[ "$CREDENTIALS" != *:* ]]; then
    printf 'Invalid credentials format, expected <user>:<pass>\n' >&2
    exit 1
fi

VM_USER="${CREDENTIALS%%:*}"
VM_PASS="${CREDENTIALS#*:}"
REMOTE_SETUP_DIR="/home/${VM_USER}/${REMOTE_SETUP_DIR_BASE}"

if ! command -v sshpass >/dev/null 2>&1; then
    printf 'sshpass is required but not installed. Install it with: brew install hudochenkov/sshpass/sshpass\n' >&2
    exit 1
fi

ssh_run() {
    sshpass -p "$VM_PASS" ssh -p "$PORT" "${SSH_OPTS[@]}" "${VM_USER}@${SSH_HOST}" "$@"
}

scp_run() {
    sshpass -p "$VM_PASS" scp -P "$PORT" "${SSH_OPTS[@]}" "$@"
}

printf 'Connecting to %s@%s:%s\n' "$VM_USER" "$SSH_HOST" "$PORT"

ssh_run "mkdir -p '$REMOTE_SETUP_DIR'"

REMOTE_SCRIPT_PATHS=()
for script in "${SETUP_SCRIPTS[@]}"; do
    REMOTE_SCRIPT_PATHS+=("${REMOTE_SETUP_DIR}/${script}")
done

scp_run \
    "${SETUP_SCRIPTS[@]/#/$SCRIPT_DIR/}" \
    "${VM_USER}@${SSH_HOST}:${REMOTE_SETUP_DIR}/"

ssh_run "chmod +x ${REMOTE_SCRIPT_PATHS[*]@Q}"

for script in "${SETUP_SCRIPTS[@]}"; do
    printf 'Running %s\n' "$script"
    ssh_run "VM_PASS=$(printf '%q' "$VM_PASS") '${REMOTE_SETUP_DIR}/${script}'"
done

printf 'Setup complete.\n'
